{
    "problemMatcher": [
      {
        "owner": "pylint",
        "pattern": [
          {
            "regexp": "^([^:]+):(\\d+):(\\d+):\\s([A-Z]\\d{4}):\\s(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "code": 4,
            "message": 5
          }
        ]
      }
    ]
  }
  